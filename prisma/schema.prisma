// Prisma schema for the ERP system: PostgreSQL models for users, products, orders,
// invoices, categories, suppliers, warehouses, support tickets, reviews, notifications, etc.
// Run: npx prisma generate (after schema changes); use prisma/client for DB access.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  userId      String // Created by user ID
  status      Boolean   @default(true) // Active/Inactive status (default: active)
  description String? // Optional description field
  notes       String? // Optional notes field
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? // Manually managed - null on create, set on update
  createdBy   String // Same as userId, for clarity
  updatedBy   String? // Last updated by user ID
}

model Department {
  id String @id @default(cuid())
}

model Invoice {
  id                    String    @id @default(cuid())
  invoiceNumber         String    @unique // Unique invoice number (e.g., INV-2024-001)
  orderId               String    @unique // Reference to Order (one-to-one relationship)
  userId                String // User who created the invoice (admin/warehouse user)
  clientId              String? // Client who the invoice is for (optional)
  status                String    @default("draft") // Invoice status: draft, sent, paid, overdue, cancelled
  subtotal              Float     @default(0) // Invoice subtotal (before tax, shipping, discount)
  tax                   Float? // Tax amount (optional)
  shipping              Float? // Shipping amount (optional), same as order for transparency
  discount              Float? // Discount amount (optional)
  total                 Float     @default(0) // Total amount (subtotal + tax + shipping - discount)
  amountPaid            Float     @default(0) // Amount paid so far (for partial payments)
  amountDue             Float     @default(0) // Amount due (total - amountPaid)
  dueDate               DateTime // Invoice due date
  issuedAt              DateTime  @default(now()) // Invoice issue date
  sentAt                DateTime? // When invoice was sent to client
  paidAt                DateTime? // When invoice was paid
  cancelledAt           DateTime? // Cancellation date (if cancelled)
  paymentLink           String? // Stripe payment link (optional)
  stripePaymentIntentId String? // Stripe PaymentIntent ID for refunds
  notes                 String? // Invoice notes (optional)
  billingAddress        Json? // Billing address (JSON object with street, city, state, zipCode, country)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? // Manually managed - null on create, set on update
  createdBy             String // Same as userId, for clarity
  updatedBy             String? // Last updated by user ID
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade) // Relation to Order (one-to-one)
  // orderId already has @unique, so it's automatically indexed

  @@index([userId, status, dueDate]) // Index for efficient querying by user, status, and due date
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique // Unique order number (e.g., ORD-2024-001)
  userId                String // User who created the order (admin/warehouse user)
  clientId              String? // Client who placed the order (optional for now, will be used when client portal is implemented)
  customerId            String? // Export customer this order belongs to (foreign trade master data)
  status                String        @default("pending") // Order status: pending, confirmed, processing, shipped, delivered, cancelled
  paymentStatus         String        @default("unpaid") // Payment status: unpaid, paid, refunded, partial
  subtotal              Float         @default(0) // Order subtotal (before tax and shipping)
  tax                   Float? // Tax amount (optional)
  shipping              Float? // Shipping cost (optional)
  discount              Float? // Discount amount (optional)
  total                 Float         @default(0) // Total amount (subtotal + tax + shipping - discount)
  // Export trade fields
  currency              String? // Settlement currency (USD, EUR, CNY)
  exchangeRate          Float? // Exchange rate against CNY at order time
  tradeTerms            String? // International commercial terms (FOB, CIF, EXW)
  customsNo             String? // Customs declaration number
  portOfLoading         String? // Port of loading
  portOfDischarge       String? // Port of discharge
  // Approval tracking
  approvedById          String? // User who approved this order
  approvedAt            DateTime? // Approval timestamp
  shippingAddress       Json? // Shipping address (JSON object with street, city, state, zipCode, country)
  billingAddress        Json? // Billing address (JSON object, same structure as shippingAddress)
  notes                 String? // Order notes (optional)
  trackingNumber        String? // Shipping tracking number (from Shippo)
  trackingCarrier       String? // Shipping carrier (usps, ups, fedex, dhl, other)
  trackingUrl           String? // Shipping tracking URL (from Shippo)
  labelUrl              String? // Shipping label PDF URL (from Shippo)
  estimatedDelivery     DateTime? // Estimated delivery date
  shippedAt             DateTime? // Actual shipping date
  deliveredAt           DateTime? // Actual delivery date
  cancelledAt           DateTime? // Cancellation date (if cancelled)
  stripePaymentIntentId String? // Stripe PaymentIntent ID for refunds
  createdAt             DateTime      @default(now())
  updatedAt             DateTime? // Manually managed - null on create, set on update
  createdBy             String // Same as userId, for clarity
  updatedBy             String? // Last updated by user ID
  items                 OrderItem[] // Order items (one-to-many relationship)
  invoice               Invoice? // Invoice for this order (one-to-one relationship)
  customer              Customer?     @relation(fields: [customerId], references: [id]) // Export customer master data
  performances          Performance[] // Sales performance entries linked to this order
  approvals             Approval[] // Approval history for this order
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String // Reference to Order
  productId     String // Reference to Product
  productName   String // Product name at time of order (snapshot)
  sku           String? // Product SKU at time of order (snapshot)
  quantity      Int // Quantity ordered
  price         Float // Unit price at time of order (snapshot)
  subtotal      Float // Line item subtotal (quantity * price)
  /**
   * REQ-0068 — picked source warehouse when product has allocations
   */
  warehouseId   String?
  warehouseName String? // Warehouse name snapshot at order time
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade) // Cascade delete when order is deleted
  product       Product  @relation(fields: [productId], references: [id]) // Reference to product
}

model Permission {
  id       String @id @default(cuid())
  /// Field referred in an index, but found no data to define the type.
  resource Json?
  /// Field referred in an index, but found no data to define the type.
  userId   Json?

  @@unique([userId, resource])
}

model Product {
  id               String      @id @default(cuid())
  categoryId       String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime? // Manually managed - null on create, set on update
  name             String
  price            Float
  quantity         BigInt
  reservedQuantity BigInt      @default(0) // Stock reserved by pending orders (not yet confirmed)
  lowStockThreshold Int? // Reorder point; a low-stock alert fires when quantity - reservedQuantity falls to or below it
  sku              String      @unique
  status           String
  supplierId       String
  userId           String // Created by user ID
  createdBy        String // Same as userId, for clarity
  updatedBy        String? // Last updated by user ID
  qrCodeUrl        String? // ImageKit URL for QR code image
  qrCodeFileId     String? // ImageKit file ID for cleanup when regenerating
  imageUrl         String? // ImageKit URL for product image
  imageFileId      String? // ImageKit file ID for cleanup when updating/deleting
  expirationDate   DateTime? // Product expiration date (optional, for perishable items)
  deletedAt        DateTime? // Soft-delete: set when product has order history and is "deleted"
  deletedBy        String? // User who soft-deleted the product
  orderItems       OrderItem[] // Orders containing this product (one-to-many relationship)

  @@index([deletedAt])
}

model Session {
  id           String @id @default(cuid())
  /// Field referred in an index, but found no data to define the type.
  sessionToken Json?  @unique
}

model StockAlert {
  id String @id @default(cuid())
}

model StockAllocation {
  id               String    @id @default(cuid())
  productId        String // Product this allocation is for
  warehouseId      String // Warehouse where stock is located
  quantity         BigInt    @default(0) // Quantity in this warehouse
  reservedQuantity BigInt    @default(0) // Reserved stock in this warehouse
  userId           String // User who created this allocation
  createdAt        DateTime  @default(now())
  updatedAt        DateTime?

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// Stock transfer between warehouses
model StockTransfer {
  id              String    @id @default(cuid())
  productId       String // Product being transferred
  fromWarehouseId String // Source warehouse
  toWarehouseId   String // Destination warehouse
  quantity        BigInt // Quantity transferred
  status          String    @default("pending") // pending, completed, cancelled
  notes           String? // Optional notes
  userId          String // User who initiated transfer
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
}

model Warehouse {
  id        String    @id @default(cuid())
  name      String
  address   String? // Optional address (e.g. full address or location name)
  type      String? // Optional type: main, secondary, storage, etc.
  status    Boolean   @default(true) // Active/Inactive
  userId    String // Created by user ID
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  createdBy String
  updatedBy String?

  @@index([userId])
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  userId      String // Created by user ID
  status      Boolean   @default(true) // Active/Inactive status (default: active)
  description String? // Optional description field
  notes       String? // Optional notes field
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? // Manually managed - null on create, set on update
  createdBy   String // Same as userId, for clarity
  updatedBy   String? // Last updated by user ID
}

model User {
  id               String         @id @default(cuid())
  createdAt        DateTime
  email            String         @unique
  name             String
  password         String
  updatedAt        DateTime?
  username         String?        @unique
  googleId         String? // Google OAuth ID (uniqueness enforced in app logic; @unique removed to avoid non-sparse index blocking null values)
  image            String? // User profile image URL (from Google OAuth or other sources)
  // Role for access control. Internal staff: admin, sales, finance, warehouse, purchase.
  // External portals: supplier, client. Null is treated as "user" (legacy default).
  role             String? // admin | sales | finance | warehouse | purchase | supplier | client | user
  // Email notification preferences
  emailPreferences Json? // Email notification preferences stored as JSON
  // Structure: {
  //   lowStockAlerts: boolean,
  //   stockOutNotifications: boolean,
  //   inventoryReports: boolean,
  //   productExpirationWarnings: boolean,
  //   orderConfirmations: boolean,
  //   invoiceEmails: boolean,
  //   shippingNotifications: boolean,
  //   orderStatusUpdates: boolean
  // }
  notifications    Notification[] // In-app notifications (one-to-many relationship)
  performances     Performance[] // Sales performance entries owned by this user
  approvals        Approval[] // Order approvals this user has performed
}

model UserAction {
  id String @id @default(cuid())
}

model VerificationToken {
  id    String @id @default(cuid())
  /// Field referred in an index, but found no data to define the type.
  token Json?  @unique
}

model ImportHistory {
  id          String    @id @default(cuid())
  userId      String // User who performed the import
  importType  String // Type of import: "products", "orders", "suppliers", "categories"
  fileName    String // Original file name
  fileSize    Int // File size in bytes
  totalRows   Int // Total rows in the file
  successRows Int // Number of successfully imported rows
  failedRows  Int // Number of failed rows
  errors      Json? // Array of error messages for failed rows
  status      String    @default("completed") // Import status: "processing", "completed", "failed"
  createdAt   DateTime  @default(now())
  completedAt DateTime? // When import was completed
}

model Notification {
  id        String    @id @default(cuid())
  userId    String // User who receives the notification
  type      String // Notification type: "low_stock", "stock_out", "order_confirmation", "order_status_update", etc.
  title     String // Notification title
  message   String // Notification message/content
  link      String? // Optional link to related resource (e.g., /products/:id, /orders/:id)
  read      Boolean   @default(false) // Whether notification has been read
  createdAt DateTime  @default(now())
  readAt    DateTime? // When notification was marked as read
  metadata  Json? // Optional metadata (productId, orderId, etc.)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User model

  @@index([userId, read, createdAt]) // Index for efficient querying by user, read status, and date
}

model SupportTicket {
  id           String               @id @default(cuid())
  subject      String // Ticket subject
  description  String // Ticket description/details
  status       String               @default("open") // open, in_progress, resolved, closed
  priority     String               @default("medium") // low, medium, high, urgent
  userId       String // Creator (user who opened the ticket)
  assignedToId String? // Product owner / admin to handle (set on create by user)
  productId    String? // Optional link to product
  orderId      String? // Optional link to order
  supplierId   String? // Optional link to supplier
  notes        String? // Internal admin notes
  createdAt    DateTime             @default(now())
  updatedAt    DateTime? // Manually managed
  replies      SupportTicketReply[]

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model SupportTicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String // Who wrote the reply
  body      String // Reply text
  createdAt DateTime @default(now())

  supportTicket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

model ProductReview {
  id          String    @id @default(cuid())
  productId   String // Product being reviewed
  userId      String // User who wrote the review
  orderId     String? // Order this review relates to (for one-review-per-purchase)
  orderItemId String? // Optional: specific order line (one review per order line)
  productName String // Snapshot at review time (for list display)
  productSku  String? // Snapshot at review time
  rating      Int // 1–5
  comment     String // Review text
  status      String    @default("pending") // pending, approved, rejected
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? // Manually managed

  @@index([productId])
  @@index([orderId, productId, userId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
}

// System Configuration - for app-wide settings managed by admin
model SystemConfig {
  id          String    @id @default(cuid())
  key         String    @unique // Configuration key (e.g., "company_name", "low_stock_threshold")
  value       String // Configuration value (stored as string, parsed by app)
  type        String    @default("string") // Value type: string, number, boolean, json
  label       String // Human-readable label
  description String? // Description of the setting
  category    String    @default("general") // Setting category: general, email, shipping, payment, notifications
  isPublic    Boolean   @default(false) // Whether this setting can be exposed to client
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  updatedBy   String? // Last updated by user ID

  @@index([category])
  @@index([isPublic])
}

// Audit Log - for tracking user activities and system changes
model AuditLog {
  id         String   @id @default(cuid())
  userId     String // User who performed the action
  action     String // Action type: create, update, delete, login, logout, etc.
  entityType String // Entity type: product, order, invoice, user, etc.
  entityId   String? // Entity ID (if applicable)
  details    Json? // Additional details (JSON object with changes)
  ipAddress  String? // IP address of the user
  userAgent  String? // User agent string
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// Export customer master data (a business partner, not a login account).
model Customer {
  id        String    @id @default(cuid())
  name      String // Customer company name
  country   String // Country / region (e.g., United States, Germany)
  contact   String? // Primary contact person
  phone     String? // Contact phone number
  email     String? // Contact email
  address   String? // Full address
  status    Boolean   @default(true) // Active / inactive
  notes     String? // Optional notes
  createdAt DateTime  @default(now())
  updatedAt DateTime? // Manually managed - null on create, set on update
  createdBy String // Same as userId, for clarity
  updatedBy String? // Last updated by user ID
  orders    Order[] // Orders placed by this customer

  @@index([country])
  @@index([status])
}

// Sales performance entry: one order contributes to exactly one salesperson's monthly result.
// The month/year fields are the *attribution* period, which may differ from the order date
// (e.g., an order shipped in January can be attributed to December) and can be adjusted.
model Performance {
  id        String    @id @default(cuid())
  orderId   String // Order this performance entry comes from
  salesId   String // Salesperson (User with role=sales) this performance belongs to
  month     Int // Attribution month (1-12)
  year      Int // Attribution year (e.g., 2026)
  amount    Float // Performance amount (usually order total)
  notes     String? // Reason for manual attribution changes
  createdAt DateTime  @default(now())
  updatedAt DateTime? // Manually managed - null on create, set on update
  updatedBy String? // Last user who adjusted this entry
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sales     User      @relation(fields: [salesId], references: [id])

  @@index([salesId, year, month])
  @@index([orderId])
}

// Order approval history: every approve/reject action is recorded for audit purposes.
model Approval {
  id         String   @id @default(cuid())
  orderId    String // Order under approval
  approverId String // User who performed the action
  action     String // approve | reject
  comment    String? // Optional decision comment
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approver   User     @relation(fields: [approverId], references: [id])

  @@index([orderId])
  @@index([approverId])
  @@index([createdAt])
}

// Purchase order placed with a supplier. Receiving it puts stock into a warehouse.
model PurchaseOrder {
  id          String    @id @default(cuid())
  purchaseNo  String    @unique // Human-readable number, e.g. PR-2026-001
  supplierId  String // Supplier this purchase is placed with
  warehouseId String? // Receiving warehouse
  status      String    @default("draft") // draft, pending, approved, received, cancelled
  currency    String? // Settlement currency
  total       Float     @default(0) // Sum of line subtotals
  expectedAt  DateTime? // Expected arrival date
  receivedAt  DateTime? // Actual receiving date
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? // Manually managed - null on create, set on update
  createdBy   String
  updatedBy   String?
  items       PurchaseOrderItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  productName     String // Snapshot at purchase time
  sku             String? // Snapshot at purchase time
  quantity        Int
  unitCost        Float // Purchase price per unit
  subtotal        Float // quantity * unitCost
  createdAt       DateTime @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
}

// AI assistant knowledge base. Retrieval matches the user's question against these articles
// before falling back to the language model.
model KnowledgeArticle {
  id        String    @id @default(cuid())
  question  String // Canonical question / topic this article answers
  answer    String // Answer text handed to the assistant as grounding context
  category  String    @default("general") // general, order, inventory, purchase, finance, shipping
  keywords  String? // Comma-separated extra matching terms
  status    Boolean   @default(true) // Active / inactive
  hitCount  Int       @default(0) // How many times this article matched a question
  createdAt DateTime  @default(now())
  updatedAt DateTime? // Manually managed - null on create, set on update
  createdBy String
  updatedBy String?

  @@index([category])
  @@index([status])
}

// AI assistant conversation log. Kept so answers can be traced back to their source.
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String // Conversation thread id
  userId    String? // Null for anonymous visitors
  role      String // user | assistant
  content   String // Message body
  source    String? // knowledge | model | fallback — where an assistant answer came from
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([userId])
}
